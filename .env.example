# ─── Server ────────────────────────────────────────────────────────────────
# PORT=4321
# HOST=127.0.0.1
# DB_PATH=./data/competepulse.db

# ─── Scraping ──────────────────────────────────────────────────────────────
# When absent, CompetePulse uses its native fetch + readability extractor.
# FIRECRAWL_API_KEY=fc-...
# FIRECRAWL_API_URL=https://api.firecrawl.dev/v2/scrape

# ─── LLM synthesis + embeddings ────────────────────────────────────────────
# When absent, deterministic rubric analysis and local hash embeddings are used.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Vector database (optional; SQLite is always the local index) ───────────
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=...
# QDRANT_COLLECTION=competepulse

# ─── Delivery ──────────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# RESEND_API_KEY=re_...
